#!/usr/bin/env bash
# Agent Watcher hook: turns one agent hook invocation into a state-file update
# plus a shell ping, or dumps the current state for the shell.
#
#   agent-watcher-hook <agent> <event>     stdin: the agent's hook JSON
#   agent-watcher-hook dump                prune dead sessions, print JSON array
#
#   agent: claude | codex | gemini | opencode
#   event: session-start | prompt | waiting | tool-done | done | session-end
#          | rename (title-only update; the session must already exist)
#
# Silent and always exit 0 on the hook path: agents treat exit codes and
# stdout as control signals. Set AGENT_WATCHER_DEBUG=1 to keep stderr.

STATE_DIR="${AGENT_WATCHER_STATE_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-agent-watcher}"
PLUGIN_ID="io.github.5d0tal1gat0r.agent-watcher"

agent_pattern() { # ERE matched against an ancestor's cmdline (NULs -> spaces)
  case "$1" in
    claude)   printf '%s' '(^|[/ ])claude([ -]|$)' ;;
    codex)    printf '%s' '(^|[/ ])codex([ -]|$)' ;;
    gemini)   printf '%s' 'gemini' ;;
    opencode) printf '%s' '(^|[/ ])opencode([ -]|$)' ;;
    *)        printf '%s' '^$' ;;
  esac
}

cmdline_of() { tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null; }

# Internal helper processes an agent spawns for its own background sessions.
# A hook fired from underneath one of these belongs to the agent's plumbing,
# not to a session the user opened, so it is ignored (Claude Code 2.1.x runs a
# `claude daemon` that starts `bg-pty-host` sessions and pre-warmed spares,
# each of which fires SessionStart with its own session id).
helper_pattern() { # ERE matched against an ancestor's cmdline; empty = none
  case "$1" in
    claude) printf '%s' '(^|[/ ])claude (daemon|bg-pty-host|bg-spare)( |$)|--bg-pty-host|--bg-spare' ;;
    *)      printf '%s' '' ;;
  esac
}

# Shared background servers that run the hooks on behalf of several frontends
# (Codex >= 0.16x starts one `codex app-server` daemon from the first TUI and
# every later TUI talks to it). The parent chain of a hook fired from inside
# one leads to whichever TUI spawned the daemon, not to the session's own
# terminal, so the frontend has to be found another way (see resolve_client).
hosted_pattern() { # ERE matched against an ancestor's cmdline; empty = none
  case "$1" in
    codex) printf '%s' '(^|[/ ])codex app-server( |$)' ;;
    *)     printf '%s' '' ;;
  esac
}

is_hosted() { # is_hosted <pid> <agent>
  local p
  p=$(hosted_pattern "$2")
  [ -n "$p" ] && cmdline_of "$1" | grep -Eq "$p"
}

alive() { # alive <pid> <agent>: process exists and still looks like that agent
  [ -n "$1" ] && [ "$1" -gt 0 ] 2>/dev/null && [ -d "/proc/$1" ] || return 1
  cmdline_of "$1" | grep -Eq "$(agent_pattern "$2")"
}

# Walk the whole parent chain. Sets AGENT_PID (first ancestor whose cmdline
# matches the agent, skipping only this script itself -- an agent may well
# carry "agent-watcher" in its argv, e.g. a prompt about this plugin),
# HELPER_ANCESTOR=1 when any ancestor matches the agent's helper pattern, and,
# when need_window=1, WINDOW_ADDRESS (first ancestor that owns a Hyprland
# client, bare hex). The walk never stops early: helper processes sit above
# the agent process, so they must be seen even when the window is cached.
CLIENTS_FETCHED=0
CLIENTS=""
hypr_clients() { # "<pid> <address>" per Hyprland window, fetched once per run
  if [ "$CLIENTS_FETCHED" = 0 ]; then
    CLIENTS_FETCHED=1
    CLIENTS=$(hyprctl clients -j 2>/dev/null | jq -r '.[] | "\(.pid) \(.address)"' 2>/dev/null)
  fi
  printf '%s' "$CLIENTS"
}

# Bare-hex address of the Hyprland window owned by <pid> or its nearest
# ancestor; empty when none (tmux, ssh, no compositor).
window_of() { # window_of <pid>
  local pid="$1" clients win
  clients=$(hypr_clients)
  [ -n "$clients" ] || return 0
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    win=$(printf '%s\n' "$clients" | awk -v p="$pid" '$1 == p { sub(/^0x/, "", $2); print tolower($2); exit }')
    if [ -n "$win" ]; then printf '%s' "$win"; return 0; fi
    pid=$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)
  done
}

resolve_ancestry() { # resolve_ancestry <agent> <need_window:0|1>
  local agent="$1" need_window="$2" pid=$$ pattern helpers clients="" cmd
  pattern=$(agent_pattern "$agent")
  helpers=$(helper_pattern "$agent")
  AGENT_PID=0
  WINDOW_ADDRESS=""
  HELPER_ANCESTOR=0
  if [ "$need_window" = 1 ]; then
    clients=$(hypr_clients)
  fi
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    cmd=$(cmdline_of "$pid")
    if [ "$AGENT_PID" = 0 ] && [ "${cmd#*agent-watcher-hook}" = "$cmd" ] && printf '%s' "$cmd" | grep -Eq "$pattern"; then
      AGENT_PID=$pid
    fi
    if [ -n "$helpers" ] && [ "$HELPER_ANCESTOR" = 0 ] && printf '%s' "$cmd" | grep -Eq "$helpers"; then
      HELPER_ANCESTOR=1
    fi
    if [ -n "$clients" ] && [ -z "$WINDOW_ADDRESS" ]; then
      WINDOW_ADDRESS=$(printf '%s\n' "$clients" | awk -v p="$pid" '$1 == p { sub(/^0x/, "", $2); print tolower($2); exit }')
    fi
    pid=$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)
  done
}

# agentPid of every other session of <agent>, one per line.
bound_pids() { # bound_pids <agent> <session_id>
  local f
  for f in "$STATE_DIR/$1"-*.json; do
    [ -e "$f" ] || continue
    jq -r --arg s "$2" 'select(.sessionId != $s) | (.agentPid // 0)' "$f" 2>/dev/null
  done
}

# A hook fired inside a hosted daemon: find the frontend (TUI) process the
# session belongs to. Sets CLIENT_PID (0 = undecided) and CLIENT_WINDOW.
#   candidates: live agent processes that are not the daemon, preferring the
#     ones started in the session's working directory (wrappers whose child
#     is also a candidate are dropped);
#   1. the candidate whose window has focus (prompts are typed there, and
#      Codex fires SessionStart on the first prompt);
#   2. else the only candidate not yet bound to another session;
#   3. else the only candidate. Anything more ambiguous stays undecided
#      rather than pinning the session to the wrong window.
resolve_client() { # resolve_client <agent> <cwd> <session_id>
  local agent="$1" cwd="$2" sid="$3" pattern hosted p q c pp all="" same="" cands final="" active w bound free="" nfree=0 n=0 rcwd=""
  CLIENT_PID=0
  CLIENT_WINDOW=""
  pattern=$(agent_pattern "$agent")
  hosted=$(hosted_pattern "$agent")
  [ -n "$cwd" ] && rcwd=$(readlink -f "$cwd" 2>/dev/null)
  while read -r p; do
    [ -n "$p" ] && [ "$p" != $$ ] || continue
    c=$(cmdline_of "$p")
    [ "${c#*agent-watcher-hook}" = "$c" ] || continue
    printf '%s' "$c" | grep -Eq "$pattern" || continue
    [ -n "$hosted" ] && printf '%s' "$c" | grep -Eq "$hosted" && continue
    all="$all $p"
    if [ -n "$rcwd" ] && [ "$(readlink -f "/proc/$p/cwd" 2>/dev/null)" = "$rcwd" ]; then same="$same $p"; fi
  done < <(pgrep -f -- "$agent" 2>/dev/null)
  cands=${same:-$all}
  for p in $cands; do
    for q in $cands; do
      pp=$(awk '/^PPid:/ { print $2 }' "/proc/$q/status" 2>/dev/null)
      [ "$pp" = "$p" ] && continue 2
    done
    final="$final $p"
  done
  [ -n "$final" ] || return 0
  active=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""' 2>/dev/null | sed 's/^0x//' | tr 'A-F' 'a-f')
  if [ -n "$active" ]; then
    for p in $final; do
      w=$(window_of "$p")
      if [ "$w" = "$active" ]; then CLIENT_PID=$p; CLIENT_WINDOW=$w; return 0; fi
    done
  fi
  bound=$(bound_pids "$agent" "$sid")
  for p in $final; do
    n=$((n+1))
    printf '%s\n' "$bound" | grep -qx "$p" || { free="$free $p"; nfree=$((nfree+1)); }
  done
  if [ "$nfree" = 1 ]; then CLIENT_PID=${free# }
  elif [ "$n" = 1 ]; then CLIENT_PID=${final# }
  else return 0
  fi
  CLIENT_WINDOW=$(window_of "$CLIENT_PID")
}

ping_shell() {
  local cli
  cli=$(command -v omarchy-shell 2>/dev/null)
  [ -n "$cli" ] || cli=/usr/share/omarchy/bin/omarchy-shell
  [ -x "$cli" ] || return 0
  OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}" "$cli" -q "$PLUGIN_ID" refresh >/dev/null 2>&1 || true
}

# True when the process was re-parented to init / the systemd user manager:
# its terminal (and the shell in it) is gone. Agents that ignore SIGHUP —
# OpenCode does — linger this way after their window is closed.
orphaned() { # orphaned <pid>
  local ppid comm
  ppid=$(awk '/^PPid:/ { print $2 }' "/proc/$1/status" 2>/dev/null)
  [ -n "$ppid" ] || return 1
  [ "$ppid" -le 1 ] 2>/dev/null && return 0
  comm=$(cat "/proc/$ppid/comm" 2>/dev/null)
  [ "$comm" = systemd ]
}

# Bare-hex addresses of the Hyprland windows that currently exist, one per
# line; fetched lazily (once per dump) and only when a session needs it.
WINDOWS_FETCHED=0
WINDOWS=""
window_exists() { # window_exists <bare-hex-address>
  if [ "$WINDOWS_FETCHED" = 0 ]; then
    WINDOWS_FETCHED=1
    WINDOWS=$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' 2>/dev/null | sed 's/^0x//' | tr 'A-F' 'a-f')
    # No compositor answer: assume windows still exist rather than prune.
    [ -n "$WINDOWS" ] || WINDOWS="?"
  fi
  [ "$WINDOWS" = "?" ] && return 0
  printf '%s\n' "$WINDOWS" | grep -qx "$1"
}

# Claude Code ends a turn without any hook when the user denies a permission
# or presses Esc; its transcript, though, gets the interruption (or the
# turn's closing turn_duration record) right away. True when the last
# conversational record of <transcript> closes the turn and is newer than
# <updatedAt> (the state file's last event, whole seconds: a record from the
# same second is not trusted to come after it).
turn_ended_after() { # turn_ended_after <transcript> <updatedAt>
  [ -r "$1" ] || return 1
  tail -n 60 "$1" 2>/dev/null | jq -cR 'fromjson? // empty' 2>/dev/null | jq -es --argjson since "${2:-0}" '
    map(select(type == "object" and (.type == "user" or .type == "assistant"
      or (.type == "system" and .subtype == "turn_duration")))) | last
    | select(. != null)
    | ((.timestamp // "") | sub("\\.[0-9]+Z$"; "Z") | (try fromdateiso8601 catch 0)) as $t
    | $t > $since and (
        .type == "system"
        or (.type == "user" and ((.message.content // "")
              | if type == "array" then map(.text? // "") | join("") else tostring end
              | startswith("[Request interrupted by user"))))
  ' >/dev/null 2>&1
}

dump() {
  # No jq means we cannot tell a broken state file from a good one, so prune
  # nothing: deleting every session here would lose live sessions for good.
  command -v jq >/dev/null 2>&1 || { printf '[]\n'; return 0; }
  mkdir -p "$STATE_DIR" 2>/dev/null
  local f agent pid win state updated transcript out
  local files=() ended=()
  for f in "$STATE_DIR"/*.json; do
    [ -e "$f" ] || continue
    # Unreadable or already gone (a concurrent session-end): skip, never delete.
    [ -r "$f" ] || continue
    if ! agent=$(jq -er '.agent | strings' "$f" 2>/dev/null); then
      # Only delete when jq ran against a file that is still there: that is a
      # real parse failure, not a race.
      [ -e "$f" ] && rm -f "$f"
      continue
    fi
    { read -r pid; read -r win; read -r state; read -r updated; read -r transcript; } < <(
      jq -r '((.agentPid // 0) | tostring), (.windowAddress // ""), (.state // ""),
             ((.updatedAt // 0) | tostring), (.transcriptPath // "")' "$f" 2>/dev/null)
    if [ "${pid:-0}" -gt 0 ] 2>/dev/null && ! alive "$pid" "$agent"; then rm -f "$f"; continue; fi
    # The window it was started in is gone and no live process vouches for
    # it — either we never learned the pid, or the agent survived the hangup
    # and now hangs off init/systemd (OpenCode does that): the user closed the
    # terminal. Not a session anyone can reach any more; drop it. A tmux/nohup
    # session that never had a window keeps its empty address and is left alone.
    if [ -n "$win" ] && { [ "${pid:-0}" -le 0 ] 2>/dev/null || orphaned "$pid"; } && ! window_exists "$win"; then
      rm -f "$f"; continue
    fi
    files+=("$f")
    if [ "$agent" = claude ] && { [ "$state" = working ] || [ "$state" = waiting ]; } && [ -n "$transcript" ] &&
       turn_ended_after "$transcript" "$updated"; then
      ended+=("$f")
    fi
  done
  if [ "${#files[@]}" -eq 0 ]; then printf '[]\n'; return 0; fi
  # Interrupted turns are reported as idle without touching the file: the
  # next real hook event simply overrides it.
  local ended_json fix='map(select(type == "object"))'
  ended_json=$(jq -cn '$ARGS.positional' --args "${ended[@]}" 2>/dev/null) || ended_json='[]'
  fix='[inputs | select(type == "object") | (input_filename) as $f
        | if ($ended | index($f)) then .state = "idle" | .lastEvent = "interrupted" else . end]'
  # jq fails wholesale if one file vanished since the loop; fall back to
  # reading them one by one rather than reporting "no sessions at all".
  if out=$(jq -n --argjson ended "$ended_json" "$fix" "${files[@]}" 2>/dev/null); then
    printf '%s\n' "$out"
  else
    { for f in "${files[@]}"; do
        [ -r "$f" ] && jq -c --argjson ended "$ended_json" --arg f "$f" \
          'select(type == "object") | if ($ended | index($f)) then .state = "idle" | .lastEvent = "interrupted" else . end' "$f" 2>/dev/null
      done; } | jq -s '.'
  fi
}

if [ "${1:-}" = dump ]; then
  dump
  exit 0
fi

# ---- hook path: from here on nothing reaches stdout, and we always exit 0.
exec 1>/dev/null
[ "${AGENT_WATCHER_DEBUG:-0}" = 1 ] || exec 2>/dev/null

AGENT="${1:-}"
EVENT="${2:-}"
case "$AGENT" in claude|codex|gemini|opencode) ;; *) exit 0 ;; esac
case "$EVENT" in
  session-start) STATE=idle ;;
  prompt)        STATE=working ;;
  waiting)       STATE=waiting ;;
  tool-done)     STATE=working ;;
  done)          STATE=done ;;
  session-end)   STATE="" ;;
  rename)        STATE="" ;;
  *) exit 0 ;;
esac

INPUT=$(cat 2>/dev/null)
printf '%s' "$INPUT" | jq -e . >/dev/null 2>&1 || INPUT='{}'
SESSION_ID=$(printf '%s' "$INPUT" | jq -r '.session_id // .sessionID // .sessionId // empty' 2>/dev/null)
CWD=$(printf '%s' "$INPUT" | jq -r '.cwd // .directory // empty' 2>/dev/null)
# Optional session name supplied by the agent (OpenCode sends its session
# title); other agents leave it empty and the shell falls back to the window
# title / project name.
TITLE=$(printf '%s' "$INPUT" | jq -r '.title // empty' 2>/dev/null)
# Claude Code's transcript lets the dump notice turns that ended without a
# hook (a denied permission, Esc).
TRANSCRIPT=$(printf '%s' "$INPUT" | jq -r '.transcript_path // empty' 2>/dev/null)

# Gemini fires Notification for more than permissions; only ToolPermission blocks.
if [ "$AGENT" = gemini ] && [ "$EVENT" = waiting ]; then
  nt=$(printf '%s' "$INPUT" | jq -r '.notification_type // empty' 2>/dev/null)
  [ -z "$nt" ] || [ "$nt" = ToolPermission ] || exit 0
fi

AGENT_PID=0
WINDOW_ADDRESS=""
if [ -z "$SESSION_ID" ]; then
  resolve_ancestry "$AGENT" 0
  SESSION_ID="pid$AGENT_PID"
fi
SAFE_ID=$(printf '%s' "$SESSION_ID" | tr -c 'A-Za-z0-9._-' '_')
FILE="$STATE_DIR/$AGENT-$SAFE_ID.json"

if [ "$EVENT" = session-end ]; then
  rm -f "$FILE"
  ping_shell
  exit 0
fi

PREV_STATE=""; PREV_WINDOW=""; PREV_PID=0; PREV_CWD=""; PREV_TITLE=""; PREV_TRANSCRIPT=""
if [ -f "$FILE" ]; then
  { read -r PREV_STATE; read -r PREV_WINDOW; read -r PREV_PID; read -r PREV_CWD; read -r PREV_TITLE; read -r PREV_TRANSCRIPT; } < <(
    jq -r '(.state // ""), (.windowAddress // ""), ((.agentPid // 0)|tostring), (.cwd // "" | gsub("\n"; " ")),
           (.title // "" | gsub("\n"; " ")), (.transcriptPath // "")' "$FILE" 2>/dev/null)
fi
# rename touches only the title: state, timestamps and lastEvent stay put so
# the shell does not mistake it for new activity (which would re-arm a blink
# the user already acknowledged). Unknown sessions are ignored.
if [ "$EVENT" = rename ]; then
  [ -f "$FILE" ] || exit 0
  [ "$TITLE" != "$PREV_TITLE" ] || exit 0
  TMP="$FILE.tmp.$$"
  if jq --arg title "$TITLE" '.title = $title' "$FILE" > "$TMP" 2>/dev/null; then
    mv -f "$TMP" "$FILE" 2>/dev/null
    ping_shell
  fi
  rm -f "$TMP" 2>/dev/null
  exit 0
fi
# tool-done only matters while blocked on a permission.
if [ "$EVENT" = tool-done ] && [ "$PREV_STATE" != waiting ]; then exit 0; fi
[ -n "$CWD" ] || CWD="$PREV_CWD"
[ -n "$TITLE" ] || TITLE="$PREV_TITLE"
[ -n "$TRANSCRIPT" ] || TRANSCRIPT="$PREV_TRANSCRIPT"
case $PREV_PID in ''|*[!0-9]*) PREV_PID=0 ;; esac

# The window is resolved once per session (hyprctl is the expensive part).
if [ -n "$PREV_WINDOW" ]; then
  resolve_ancestry "$AGENT" 0
  WINDOW_ADDRESS="$PREV_WINDOW"
else
  resolve_ancestry "$AGENT" 1
fi
# A session spawned by the agent's own background plumbing is not the user's:
# ignore it and drop anything an earlier event of it may have written.
if [ "${HELPER_ANCESTOR:-0}" = 1 ]; then
  rm -f "$FILE"
  exit 0
fi
# Fired from a shared daemon: the parent chain says nothing about this
# session's terminal. Keep the frontend found earlier while it lives,
# otherwise look for it; undecided sessions keep the daemon's pid (so they
# still vanish with it) and no window.
if [ "$AGENT_PID" != 0 ] && is_hosted "$AGENT_PID" "$AGENT"; then
  if [ "$PREV_PID" != 0 ] && ! is_hosted "$PREV_PID" "$AGENT" && alive "$PREV_PID" "$AGENT"; then
    AGENT_PID=$PREV_PID
    WINDOW_ADDRESS="$PREV_WINDOW"
  else
    resolve_client "$AGENT" "$CWD" "$SESSION_ID"
    if [ "$CLIENT_PID" != 0 ]; then
      AGENT_PID=$CLIENT_PID
      WINDOW_ADDRESS="$CLIENT_WINDOW"
    else
      WINDOW_ADDRESS=""
    fi
  fi
fi
[ "$AGENT_PID" != 0 ] || AGENT_PID="$PREV_PID"
case $AGENT_PID in ''|*[!0-9]*) AGENT_PID=0 ;; esac

if [ "$EVENT" = session-start ]; then
  # Same process, same session: a resume or a context compaction (Claude Code
  # fires SessionStart again, possibly mid-turn). Nothing new to report, and
  # rewriting the file would reset a working/done state to idle.
  if [ -n "$PREV_STATE" ] && [ "$AGENT_PID" != 0 ] && [ "$AGENT_PID" = "$PREV_PID" ]; then exit 0; fi
  # A new session in a process that already had one (/clear, /new, /resume):
  # one terminal shows one conversation, so the old one is gone from view.
  # OpenCode is excluded: one process serves several sessions side by side.
  if [ "$AGENT" != opencode ] && [ "$AGENT_PID" != 0 ] && ! is_hosted "$AGENT_PID" "$AGENT"; then
    for f in "$STATE_DIR/$AGENT"-*.json; do
      [ -e "$f" ] && [ "$f" != "$FILE" ] || continue
      [ "$(jq -r '.agentPid // 0' "$f" 2>/dev/null)" = "$AGENT_PID" ] && rm -f "$f"
    done
  fi
fi

mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
NOW=$(date +%s)
TMP="$FILE.tmp.$$"
if jq -n --arg agent "$AGENT" --arg sessionId "$SESSION_ID" --arg state "$STATE" --arg cwd "$CWD" \
      --argjson agentPid "${AGENT_PID:-0}" --arg windowAddress "$WINDOW_ADDRESS" \
      --argjson updatedAt "$NOW" --arg lastEvent "$EVENT" --arg title "$TITLE" --arg transcriptPath "$TRANSCRIPT" \
      '{agent: $agent, sessionId: $sessionId, state: $state, cwd: $cwd, agentPid: $agentPid,
        windowAddress: $windowAddress, updatedAt: $updatedAt, lastEvent: $lastEvent, title: $title,
        transcriptPath: $transcriptPath}' > "$TMP" 2>/dev/null; then
  mv -f "$TMP" "$FILE" 2>/dev/null
fi
rm -f "$TMP" 2>/dev/null
ping_shell
exit 0
